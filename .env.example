# Desenvolvimento: copie para .env. Better Auth local, Postgres e RustFS do
# compose.yaml (bun run infra:up). Produção usa Neon: veja .env.production.example.
AUTH_MODE=local
AUTH_BASE_URL=http://localhost:3000
AUTH_SECRET=local-only-secret-change-before-use-123456789
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/my_database

AWS_ENDPOINT_URL_S3=http://localhost:9000
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password123
AWS_REGION=us-east-1
NEON_STORAGE_BUCKET=workplace
NEON_POST_BUCKET=post

# Estimativa de distância das viagens (opcional; padrão: serviços públicos do OpenStreetMap)
GEOCODER_BASE_URL=
GEOCODER_USER_AGENT=
ROUTING_BASE_URL=

# Cadastro aberto: true deixa qualquer pessoa criar conta e a própria organização no onboarding.
# Vazio: só a primeira conta se cadastra; as demais são adicionadas pela administração.
ALLOW_SIGNUP=
