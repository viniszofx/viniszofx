# Server only. Do not prefix secrets with NEXT_PUBLIC_.
# Use the DATABASE_URL and Auth URL from the same Neon branch.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Local/manual configuration. In Vercel, the Neon integration injects
# NEON_AUTH_BASE_URL for each deployment; it takes precedence over AUTH_NEON_URL.
AUTH_NEON_URL=https://YOUR-ENDPOINT.neonauth.REGION.aws.neon.tech/neondb/auth
JWKS_URL=https://YOUR-ENDPOINT.neonauth.REGION.aws.neon.tech/neondb/auth/.well-known/jwks.json
NEON_AUTH_COOKIE_SECRET=GENERATE_A_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS

# Optional canonical site URL (recommended in production):
# SITE_URL=https://your-production-domain.example

# Neon Object Storage bucket in this branch.
AWS_ENDPOINT_URL_S3=https://YOUR-ENDPOINT.storage.REGION.aws.neon.tech
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
AWS_REGION=us-east-2
NEON_STORAGE_BUCKET=workplace
NEON_POST_BUCKET=post
