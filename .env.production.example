# Produção (compose.prod.yaml) com Neon. Copie para .env.production.
# Use DATABASE_URL, Neon Auth e Object Storage da mesma branch do Neon.
# Não defina AUTH_MODE: sem ele a aplicação usa o Neon Auth.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
AUTH_NEON_URL=https://YOUR-ENDPOINT.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=GENERATE_A_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS
SITE_URL=https://your-production-domain.example

AWS_ENDPOINT_URL_S3=https://YOUR-ENDPOINT.storage.REGION.aws.neon.tech
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
AWS_REGION=us-east-2
NEON_STORAGE_BUCKET=workplace
NEON_POST_BUCKET=post

# Porta publicada no host
APP_PORT=3000

# Estimativa de distância das viagens (opcional; padrão: serviços públicos do OpenStreetMap)
GEOCODER_BASE_URL=
GEOCODER_USER_AGENT=
ROUTING_BASE_URL=

# Cadastro aberto: true deixa qualquer pessoa criar conta e a própria organização no onboarding.
# Vazio: só a primeira conta se cadastra; as demais são adicionadas pela administração.
ALLOW_SIGNUP=
